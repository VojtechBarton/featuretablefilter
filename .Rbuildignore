# Ignore version control and IDE files
^\.git$
^\.gitignore$
^\.claude$
^\.idea$
^\.dockerignore$
.*\.Rproj$
^.*\.Rproj$

# Ignore build and check artifacts
.*\.tar\.gz$
^.*_Rcheck/$
^\.Rcheck/
.*\.Rout$
.*\.Rout\.save$
.*\.o$
.*\.so$
.*\.dll$

# IDE and editor files
^\.vscode/
.*\.swp$
.*\.swo$
.*~$
\.DS_Store$
Thumbs\.db$

# Temporary files
^tmp/$
^temp/
.*\.tmp$
\.Rplots\.pdf$

# Vignette caches
^vignettes/cache/

# Local configuration
^\.local/

# Environment variables
^\.env$

# Log files
.*\.log$

# Docker
^Dockerfile$
^docker-compose\.yml$
^docker/$
^\.dockerignore$

# BiocCheck / R check output directories
.*\.BiocCheck$
^\.\.Rcheck/
^\.Rcheck/

# Pre-built vignette outputs (Bioconductor builds these during check)
^vignettes/.*\.html$

# Claude Code session data
^\.claude/

# Report outputs from pipeline examples
.*_filtering_report\..*$
^results/

# Data generation scripts
^data-raw/$

# Non-package documentation and project files
^Tutorial\.md$
^featuretablefilter\.md$
^manuscript/$
^CHANGELOG\.md$
^CLAUDE\.md$
^CODE_OF_CONDUCT\.md$
^CONTRIBUTING\.md$
^SECURITY\.md$
^SHINY_DASHBOARD_PLAN\.md$
^\.github
